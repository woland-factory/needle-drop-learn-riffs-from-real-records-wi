# All values are optional. The app runs normally when they are empty.
# Error tracking (GlitchTip / Sentry compatible). Leave empty to disable.
SENTRY_DSN=
# Umami analytics. Both values are required to load the script.
UMAMI_WEBSITE_ID=
UMAMI_URL=
# Host port for the staging container. Maps to container port 80.
NEEDLE_DROP_PORT=8080
